<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.plagiarismcheckerplus</groupId>
  <artifactId>sdk</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Plagiarism Checker Plus SDK</name>
  <description>Official Java client for the Plagiarism Checker Plus API: plagiarism checks with sources and AI writing detection.</description>
  <url>https://plagiarismcheckerplus.com</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Plagiarism Checker Plus</name>
      <email>contact@plagiarismcheckerplus.com</email>
      <organization>Plagiarism Checker Plus</organization>
      <organizationUrl>https://plagiarismcheckerplus.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/pcp-tech/plagiarism-checker-plus-sdk.git</connection>
    <url>https://github.com/pcp-tech/plagiarism-checker-plus-sdk</url>
  </scm>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
